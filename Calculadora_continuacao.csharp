int a, b;
double x;
Console.Write("Calculadora. \n");

Console.Write("\nDigite o valor de a = ");
a = Convert.ToInt32(Console.ReadLine());
Console.WriteLine("\nDigite o valor de b = ");
b = Convert.ToInt32(Console.ReadLine());
x = 10.5;
a = (int)x;

Console.Write("\nValor da soma = " +  (a + b) );
Console.Write("\nValor da subtração = " + (a - b));
Console.Write("\nValor da multipliacação = " + (a * b));
Console.Write("\nValor da divisão = " + ((double)a/b));
